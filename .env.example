# Configure these in Netlify: Site configuration > Environment variables.
# Never commit real API keys to GitHub.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Resend: create an API key and verify the sending domain before production use.
RESEND_API_KEY=
EMAIL_FROM=Haven Built <website@your-verified-domain.com>
OWNER_EMAIL=havensbuiltservices@gmail.com
